    {
      "id": 12,
      "type": "timeseries",
      "title": "Échecs de poignée de main TLS",
      "description": "Clients qui n'achèvent pas le TLS : scanners de certificats, vieux clients, sondes. Un pic soudain = balayage de la machine.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "sum(count_over_time({source=\"haproxy\", type=\"connexion\"}[$__auto]))",
          "refId": "A",
          "legendFormat": "échecs",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Latence p95 vue par HAProxy, par environnement",
      "description": "Durée totale (Ta) côté HAProxy, requêtes servies par l'application. Edge exclu : HAProxy répond seul en 0 ms.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "quantile_over_time(0.95, {source=\"haproxy\", type=\"http\", env=~\"$env\"} | json | unwrap duree_ms [$__auto]) by (env)",
          "refId": "A",
          "legendFormat": "{{env}}",
          "editorMode": "code",
          "instant": false,
          "range": true,
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 12,
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
