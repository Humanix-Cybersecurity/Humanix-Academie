        "defaults": {
          "unit": "short",
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Octets servis par adresse IP",
      "description": "Une adresse qui télécharge beaucoup plus que les autres : aspiration du site ou export massif par un compte compromis.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "topk(10, sum by (client_ip) (sum_over_time({source=\"haproxy\", type=\"http\", env=~\"$env\"} | json | unwrap octets [$__range])))",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
          "instant": true,
          "range": false,
          "queryType": "instant"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "octets",
              "client_ip": "client_ip"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
