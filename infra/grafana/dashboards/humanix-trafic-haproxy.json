      "id": 15,
      "type": "logs",
      "title": "Erreurs serveur (5xx)",
      "description": "Chaque 5xx avec son chemin et son adresse. Croiser avec les logs du conteneur app sur la même minute.",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
