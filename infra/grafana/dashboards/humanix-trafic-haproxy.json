    {
      "id": 16,
      "type": "logs",
      "title": "Journal filtrable (adresse, chemin)",
      "description": "Renseigner les variables ip et chemin en haut du tableau de bord (expressions régulières). Exemple : ip = 80\\.94\\.95\\.211, chemin = /api/auth/.*",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 0,
        "y": 47,
        "w": 24,
        "h": 12
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          },
          "expr": "{source=\"haproxy\", env=~\"$env\"} | json | client_ip =~ \"$ip\" | chemin =~ \"$chemin\"",
          "refId": "A",
          "legendFormat": "",
          "editorMode": "code",
